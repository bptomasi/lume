<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>Lume — Computing and infrastructure</title>
  </head>
  <body>
    <outline text="Kubernetes and cloud native">
      <outline
        text="Kubernetes Blog"
        type="rss"
        xmlUrl="https://kubernetes.io/feed.xml"
        htmlUrl="https://kubernetes.io/blog/"
        description="Cluster internals, scheduling, storage and Kubernetes operations."
      />
      <outline
        text="CNCF"
        type="rss"
        xmlUrl="https://www.cncf.io/feed/"
        htmlUrl="https://www.cncf.io/blog/"
        description="Cloud-native projects, adoption reports and platform engineering."
      />
      <outline
        text="Cilium"
        type="rss"
        xmlUrl="https://cilium.io/blog/rss.xml"
        htmlUrl="https://cilium.io/blog/"
        description="Container networking, eBPF, network policies and observability."
      />
      <outline
        text="Istio"
        type="rss"
        xmlUrl="https://istio.io/latest/feed.xml"
        htmlUrl="https://istio.io/latest/blog/"
        description="Service meshes, interservice traffic, mTLS and traffic policies."
      />
      <outline
        text="etcd"
        type="rss"
        xmlUrl="https://etcd.io/blog/index.xml"
        htmlUrl="https://etcd.io/blog/"
        description="Consensus, distributed storage and Kubernetes control-plane infrastructure."
      />
      <outline
        text="AWS Containers"
        type="rss"
        xmlUrl="https://aws.amazon.com/blogs/containers/feed/"
        htmlUrl="https://aws.amazon.com/blogs/containers/"
        description="Production containers and Kubernetes operations; includes AWS products."
      />
      <outline
        text="Last Week in Kubernetes Development"
        type="rss"
        xmlUrl="https://lwkd.info/feed.xml"
        htmlUrl="https://lwkd.info/"
        description="Weekly pull requests, code changes and Kubernetes development."
      />
    </outline>
    <outline text="Architecture and distributed systems">
