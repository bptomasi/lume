+#[derive(Default)]
+struct Run {
+    mask: u8,
+    length: usize,
+}
+
+impl Run {
+    fn push(
+        &mut self,
+        output: &mut Output<'_>,
+        mask: u8,
+        length: usize,
+    ) -> SixelResult<()> {
+        if self.length != 0 && self.mask != mask {
+            self.finish(output)?;
+        }
+        self.mask = mask;
+        // Ascending columns bound the sum by W; no protocol state lives here.
+        self.length += length;
+        Ok(())
+    }
+
+    fn finish(&mut self, output: &mut Output<'_>) -> SixelResult<()> {
+        if self.length != 0 {
+            output.run(self.mask, self.length)?;
+            self.length = 0;
+        }
+        Ok(())
+    }
 }

